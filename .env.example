# ---------------------------------------------------------------------------
# KuruGrid environment
#
# Copy to `.env.local` (git-ignored). Every value here is PUBLIC / client-side.
# KuruGrid is a zero-backend app: nothing here is a secret.
# ---------------------------------------------------------------------------

# Kuru CLOB orderbook (market) contract for the MON/USDC pair on Monad Testnet.
# Optional — defaults to DEFAULT_MARKET_ADDRESS in lib/constants.ts.
# Get the live list at https://app.kuru.trade and copy the market address from the URL.
NEXT_PUBLIC_KURU_MARKET_ADDRESS=0x0000000000000000000000000000000000000000

# Optional override for the Monad Testnet RPC used for read-only telemetry pings.
NEXT_PUBLIC_MONAD_RPC_URL=https://testnet-rpc.monad.xyz
